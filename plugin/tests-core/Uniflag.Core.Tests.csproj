<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The cross-platform test leg: renderer + wire codec, no SimHub, no WPF,
    no Windows. This is the suite CI gates on. The net48 project next door
    (plugin/tests/) keeps everything that genuinely needs SimHub's reference
    assemblies or Windows APIs.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- LTS target, but run on whatever runtime is present so a box with
         only a newer .NET can still run the suite. -->
    <RollForward>LatestMajor</RollForward>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>Uniflag.Tests</RootNamespace>
    <AssemblyName>Uniflag.Core.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\core\Uniflag.Core.csproj" />
    <!-- The scenario catalogue lives with the frame viewer; the smoke pass
         replays it. -->
    <ProjectReference Include="..\tools\Uniflag.Tools.csproj" />
  </ItemGroup>

</Project>
