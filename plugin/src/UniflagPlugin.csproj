<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>Uniflag</RootNamespace>
    <AssemblyName>UniflagPlugin</AssemblyName>
    <!-- Release version — kept in lockstep with firmware/Cargo.toml (HelloAck fw tail)
         and cli/Cargo.toml; the release zip ships plugin + firmware as one unit. -->
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <!-- SimHub's own DLLs are the reference surface; they are proprietary and never
         committed or shipped. Point SimHubDir at an install or an extracted installer. -->
    <SimHubDir Condition="'$(SimHubDir)' == ''">C:\Program Files (x86)\SimHub</SimHubDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- PrivateAssets keeps the reference assemblies a build-time-only dependency, so
         builds work without a Visual Studio .NET Framework targeting pack. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Internal test seams (registry key parsing, correlation tie-breaks) are unit
         tested without touching the real registry or serial ports. -->
    <InternalsVisibleTo Include="UniflagPlugin.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The renderer and wire codec live in plugin/core/ so they can be built and
         tested without Windows, SimHub or a .NET Framework targeting pack. They are
         COMPILED IN here rather than referenced as Uniflag.Core.dll on purpose: the
         release zip must contain exactly one DLL (packaging/package.ps1 audits it,
         and SimHub users drop a single file into their plugins folder). Referencing
         the project instead would ship a second assembly. -->
    <Compile Include="..\core\**\*.cs"
             Exclude="..\core\obj\**\*.cs;..\core\bin\**\*.cs"
             LinkBase="Core" />
  </ItemGroup>

  <ItemGroup>
    <!-- overlay/index.html is the single source of the overlay page: OverlayWebServer
         serves this embedded copy at GET /, and `just overlay-serve` serves the same
         file from disk for iteration. LogicalName is pinned — it is the manifest name
         OverlayWebServer.PageResourceName looks up. -->
    <EmbeddedResource Include="..\..\overlay\index.html" LogicalName="Uniflag.Web.index.html" />
  </ItemGroup>

  <ItemGroup>
    <!-- Private=false: never copy SimHub's proprietary DLLs into our output. -->
    <Reference Include="SimHub.Plugins">
      <HintPath>$(SimHubDir)\SimHub.Plugins.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GameReaderCommon">
      <HintPath>$(SimHubDir)\GameReaderCommon.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="log4net">
      <HintPath>$(SimHubDir)\log4net.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
