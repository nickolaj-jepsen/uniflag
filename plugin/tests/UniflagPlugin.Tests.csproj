<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>Uniflag.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <SimHubDir Condition="'$(SimHubDir)' == ''">C:\Program Files (x86)\SimHub</SimHubDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared with the cross-platform leg. Linked rather than duplicated: both
         suites resolve fixtures from the same repo-root probe. -->
    <Compile Include="..\tests-core\RepoPaths.cs" Link="RepoPaths.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\UniflagPlugin.csproj" />
    <!-- Private=true here (unlike src): the test runner needs SimHub.Plugins.dll on
         disk to reflect over plugin metadata. bin/ is gitignored; release artifacts
         are built from src only, so nothing proprietary ships. -->
    <Reference Include="SimHub.Plugins">
      <HintPath>$(SimHubDir)\SimHub.Plugins.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="GameReaderCommon">
      <HintPath>$(SimHubDir)\GameReaderCommon.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
